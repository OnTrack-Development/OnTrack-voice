SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_COOKIE=OTVOICESESSION

CACHE_STORE=database
QUEUE_CONNECTION=database

ONTRACK_VAULT_PATH=/home/appontrack/.ontrack-saas
ONTRACK_LEGACY_SQLITE_PATH=/home/appontrack/.ontrack-saas/ontrack-console.sqlite
ONTRACK_GEMINI_API_KEY=
ONTRACK_GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
