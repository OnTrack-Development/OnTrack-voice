APP_NAME="IO Voice"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.ontrackegy.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=appontrack_iovoice
DB_USERNAME=appontrack_iovoice
